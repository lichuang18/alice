+	for (i = 0; i < even->cluster_size; i++) {
+		inode_dec_dirty_pages(inode);
+		unlock_page(even->rpages[i]);
+	}
+	for (i = 0; i < odd->cluster_size; i++) {
+		inode_dec_dirty_pages(inode);
+		unlock_page(odd->rpages[i]);
+	}
