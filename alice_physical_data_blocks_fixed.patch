+/*
+ * Number of currently valid physical blocks in data segments, including
+ * CoPack hidden blocks.  This is not the inode compression reservation count.
+ */
+static ssize_t physical_data_blocks_show(struct f2fs_attr *a,
+		struct f2fs_sb_info *sbi, char *buf)
+{
+	struct sit_info *sit_i = SIT_I(sbi);
+	unsigned int segno;
+	u64 blocks = 0;
+
+	down_read(&sit_i->sentry_lock);
+	for (segno = 0; segno < MAIN_SEGS(sbi); segno++) {
+		struct seg_entry *se = get_seg_entry(sbi, segno);
+
+		if (IS_DATASEG(se->type))
+			blocks += se->valid_blocks;
+	}
+	up_read(&sit_i->sentry_lock);
+
+	return sysfs_emit(buf, "%llu\n", (unsigned long long)blocks);
+}
