 	if (fscrypt_inode_uses_fs_layer_crypto(even->inode))
 		return false;
 
+	/* P1 read reconstruction uses the already-held node page. */
+	if (!f2fs_copack_same_node_page(even, odd))
+		return false;
+
 	return true;
